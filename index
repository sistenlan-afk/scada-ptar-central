.btn.primary{background:var(--blue);color:#fff}
.progress{background:#e0e0e0;height:14px;border-radius:7px;overflow:hidden}.bar{height:100%;background:#7c4dff}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#fff;display:flex;justify-content:space-around;padding:8px 0;border-top:1px solid #ddd}
