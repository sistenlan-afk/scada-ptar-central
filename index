<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>SCADA PTAR Bellavista</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
:root{--blue:#0f3d5e;--green:#2e7d32;--bg:#f5f7fb}
*{box-sizing:border-box;font-family:system-ui,sans-serif}
body{margin:0;background:var(--bg);padding-bottom:80px}
.header{background:var(--blue);color:#fff;padding:12px 16px;display:flex;justify-content:space-between;align-items:center}
.logo{width:42px;height:42px;border-radius:10px;background:#fff;padding:3px}
.card,.menu-card{background:#fff;border-radius:16px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.menu-card{border-left:4px solid var(--green)}
.total-card{background:linear-gradient(135deg,#4caf50,#2e7d32);color:#fff}
.form{display:flex;flex-direction:column;gap:10px}
.form input,.form select,.form textarea{padding:12px;border:1px solid #ddd;border-radius:10px;font-size:16px;width:100%}
.hora-row{display:flex;gap:6px;align-items:center}.hora-row input{flex:1}
.hora-row button{padding:8px 10px;border-radius:8px;border:1px solid var(--blue);background:#fff;color:var(--blue)}
.total-result{background:#e3f2fd;padding:12px;border-radius:12px;font-weight:800;text-align:center;color:var(--blue);font-size:19px}
.btn{padding:14px;border-radius:12px;border:none;font-weight:700;font-size:15px}.btn.primary{background:var(--blue);color:#fff}.btn.secondary{background:#e0e0e0}
.progress{background:#e0e0e0;height:14px;border-radius:7px;overflow:hidden}.bar{height:100%;background:#7c4dff;transition:width .3s}
.tabs{display:flex;background:#fff;position:sticky;top:0;z-index:10}.tab{flex:1;padding:12px;border:none;background:#fff;font-weight:700}.tab.active{border-bottom:3px solid var(--blue);color:var(--blue)}
.tab-content{display:none;padding:12px}.tab-content.active{display:block}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#fff;display:flex;justify-content:space-around;padding:8px 0;border-top:1px solid #ddd}
.bottom-nav button{border:none;background:none;font-size:11px}
</style>
</head>
<body>
<header class="header">
<div style="display:flex;align-items:center;gap:10px">
<img src="img/logo_huevo.png" class="logo" onerror="this.style.display='none'">
<div><h1 style="margin:0;font-size:16px">PTAR Bellavista</h1><span style="font-size:10px;background:#1b8a3a;padding:2px 6px;border-radius:10px">● Conectado a la nube</span></div>
</div>
<div id="operadorActivo" style="font-size:12px;background:rgba(255,255,255,.15);padding:4px 8px;border-radius:12px">Sin turno</div>
</header>
<nav class="tabs">
<button class="tab active" id="t1" onclick="showTab('dashboard')">Dashboard</button>
<button class="tab" id="t2" onclick="showTab('operacion')">Operación</button>
<button class="tab" id="t3" onclick="showTab('gestion')">Gestión</button>
</nav>
<main>
<section id="tab-dashboard" class="tab-content active">
<div class="card total-card"><h2 style="margin:0">TOTAL CAUDAL: <span id="totalCaudalDia">0.0</span> L/s</h2><p id="detalleAforos" style="margin:6px 0">Aforo1 0 + Aforo2 0 + Aforo3 0</p><canvas id="chartAforo" height="140"></canvas></div>
<div class="card"><h3>Tanque 60L - Dosificación</h3><div><b id="saldoTanque">60.0 L (100%)</b><div class="progress"><div id="barraTanque" class="bar" style="width:100%"></div></div><small id="alertaTanque"></small></div><canvas id="chartQuimico" height="120"></canvas></div>
<div class="card"><h3>pH Entrada / Salida (7 días)</h3><canvas id="chartPh" height="120"></canvas></div>
<div class="card"><h3>Actividad del Día</h3><ul id="listaActividad" style="list-style:none;padding:0"></ul></div>
</section>
<section id="tab-operacion" class="tab-content">
<div class="menu-card"><h3>📅 Turno Ingreso/Salida</h3><div class="form"><input type="text" id="nombreOperador" placeholder="Nombre operador"><div class="hora-row"><label>Ingreso:</label><input type="datetime-local" id="horaIngreso"><button onclick="setHoraAuto('horaIngreso')">Auto</button></div><button class="btn primary" onclick="iniciarTurno()">Iniciar Turno - Guarda operador para todo el día</button><div class="hora-row"><label>Salida:</label><input type="datetime-local" id="horaSalida"><button onclick="setHoraAuto('horaSalida')">Auto</button></div><button class="btn secondary" onclick="cerrarTurno()">Cerrar Turno</button></div></div>
<div class="menu-card"><h3>💧 Aforo Volumétrico - TOTAL = A1+A2+A3</h3><div class="form"><input type="number" step="0.01" id="aforo1" placeholder="Aforo 1 L/s" oninput="calcularCaudal()"><div class="hora-row"><input type="datetime-local" id="horaAforo1"><button onclick="setHoraAuto('horaAforo1')">Auto</button></div><input type="number" step="0.01" id="aforo2" placeholder="Aforo 2 L/s" oninput="calcularCaudal()"><div class="hora-row"><input type="datetime-local" id="horaAforo2"><button onclick="setHoraAuto('horaAforo2')">Auto</button></div><input type="number" step="0.01" id="aforo3" placeholder="Aforo 3 L/s" oninput="calcularCaudal()"><div class="hora-row"><input type="datetime-local" id="horaAforo3"><button onclick="setHoraAuto('horaAforo3')">Auto</button></div><div class="total-result">TOTAL DEL DIA = <span id="totalCaudalInput">0.00</span> L/s</div><input type="text" id="operadorAforo" readonly placeholder="Operador auto"><button class="btn primary" onclick="guardarAforo()">Guardar Aforo</button></div></div>
<div class="menu-card"><h3>🧪 Dosificación 60L</h3><div class="form"><label>Saldo anterior: <span id="saldoAnteriorLabel">60.0</span> L</label><input type="number" step="0.01" id="consumoDia" placeholder="Consumo hoy (L)"><div class="hora-row"><input type="datetime-local" id="horaDosis"><button onclick="setHoraAuto('horaDosis')">Auto</button></div><input type="text" id="operadorDosis" readonly placeholder="Operador auto"><button class="btn primary" onclick="guardarDosificacion()">Guardar Dosificación</button><small>Formula: Saldo_actual = Saldo_anterior - Consumo | % = (Saldo/60)*100</small></div></div>
<div class="menu-card"><h3>🧹 Lavado Unidades</h3><div class="form"><select id="unidadLavado"><option>Desarenador</option><option>Sedimentador</option><option>Filtro</option><option>Reactor</option></select><div class="hora-row"><input type="datetime-local" id="horaLavado"><button onclick="setHoraAuto('horaLavado')">Auto fecha y hora</button></div><input type="text" id="operadorLavado" readonly placeholder="Operador auto"><textarea id="obsLavado" placeholder="Observaciones"></textarea><button class="btn primary" onclick="guardarLavado()">Registrar Lavado</button></div></div>
</section>
<section id="tab-gestion" class="tab-content">
<div class="menu-card"><h3>📊 Planilla Mensual Automatica</h3><button class="btn secondary" onclick="generarPlanilla()">Ver / Exportar Planilla</button><div id="planillaView" style="margin-top:10px"></div></div>
<div class="menu-card"><h3>pH Entrada/Salida</h3><input type="number" step="0.01" id="phEntrada" placeholder="pH Entrada"><button class="btn primary" onclick="guardarPh('entrada')">Guardar</button><br><br><input type="number" step="0.01" id="phSalida" placeholder="pH Salida"><button class="btn primary" onclick="guardarPh('salida')">Guardar</button></div>
</section>
</main>
<nav class="bottom-nav"><button onclick="showTab('dashboard')">📊<br>Dashboard</button><button onclick="showTab('operacion')">⚙️<br>Operación</button><button onclick="showTab('gestion')">📁<br>Gestión</button></nav>
<script>
function getOperador(){return localStorage.getItem('operador_actual')||''}
function setOperador(n){localStorage.setItem('operador_actual',n);updateOperadorUI()}
function updateOperadorUI(){const op=getOperador();document.getElementById('operadorActivo').innerText=op?`Turno: ${op}`:'Sin turno';['operadorAforo','operadorDosis','operadorLavado'].forEach(id=>{const e=document.getElementById(id);if(e)e.value=op});}
function setHoraAuto(id){const el=document.getElementById(id);const now=new Date();now.setMinutes(now.getMinutes()-now.getTimezoneOffset());el.value=now.toISOString().slice(0,16);}
function showTab(name){document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));document.getElementById('tab-'+name).classList.add('active');document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));const map={dashboard:'t1',operacion:'t2',gestion:'t3'};document.getElementById(map[name]).classList.add('active');}
function iniciarTurno(){const n=document.getElementById('nombreOperador').value.trim();if(!n){alert('Escribe nombre');return}setOperador(n);guardarRegistro({tipo:'turno',accion:'inicio',operador:n,fecha:document.getElementById('horaIngreso').value||new Date().toISOString()});addActividad('Inicio turno '+n);alert('Turno iniciado: '+n+' - Ahora tu nombre aparecera auto en toda la planilla del dia');}
function cerrarTurno(){const op=getOperador();guardarRegistro({tipo:'turno',accion:'cierre',operador:op,fecha:document.getElementById('horaSalida').value||new Date().toISOString()});localStorage.removeItem('operador_actual');updateOperadorUI();alert('Turno cerrado');}
let chartAforoInst;function calcularCaudal(){const a1=parseFloat(document.getElementById('aforo1').value)||0;const a2=parseFloat(document.getElementById('aforo2').value)||0;const a3=parseFloat(document.getElementById('aforo3').value)||0;const total=a1+a2+a3;document.getElementById('totalCaudalInput').innerText=total.toFixed(2);document.getElementById('totalCaudalDia').innerText=total.toFixed(2);document.getElementById('detalleAforos').innerText=`A1 ${a1} + A2 ${a2} + A3 ${a3}`;const ctx=document.getElementById('chartAforo');if(ctx){if(chartAforoInst)chartAforoInst.destroy();chartAforoInst=new Chart(ctx,{type:'bar',data:{labels:['A1','A2','A3','TOTAL'],datasets:[{label:'L/s',data:[a1,a2,a3,total],backgroundColor:['#90caf9','#64b5f6','#42a5f5','#2e7d32']}]},options:{responsive:true}});}return total;}
function getRegistros(){return JSON.parse(localStorage.getItem('registros_ptar')||'[]');}
function guardarRegistro(obj){const regs=getRegistros();regs.push(obj);localStorage.setItem('registros_ptar',JSON.stringify(regs));renderPlanilla();}
function addActividad(txt){const ul=document.getElementById('listaActividad');if(!ul)return;const li=document.createElement('li');li.style.padding='8px 0';li.style.borderBottom='1px solid #eee';li.innerText=new Date().toLocaleTimeString()+' - '+txt;ul.prepend(li);}
function getSaldoAnterior(){const regs=getRegistros().filter(r=>r.tipo==='dosificacion');if(regs.length==0)return 60;return parseFloat(regs[regs.length-1].saldo_actual)||60;}
function guardarAforo(){const total=calcularCaudal();guardarRegistro({tipo:'aforo',operador:getOperador(),aforo1:document.getElementById('aforo1').value,aforo2:document.getElementById('aforo2').value,aforo3:document.getElementById('aforo3').value,total:total,fecha:new Date().toISOString()});addActividad(`Aforo TOTAL ${total.toFixed(2)} L/s - ${getOperador()}`);alert('Aforo guardado TOTAL: '+total.toFixed(2));}
function guardarDosificacion(){const saldoAnt=getSaldoAnterior();const consumo=parseFloat(document.getElementById('consumoDia').value)||0;const saldoActual=saldoAnt-consumo;const porc=(saldoActual/60)*100;document.getElementById('saldoAnteriorLabel').innerText=saldoAnt.toFixed(1);document.getElementById('saldoTanque').innerText=`${saldoActual.toFixed(1)}L (${porc.toFixed(0)}%)`;document.getElementById('barraTanque').style.width=Math.max(0,porc)+'%';const alerta=document.getElementById('alertaTanque');if(saldoActual<10){alerta.innerText='⚠️ ALERTA Recargar tanque!';alerta.style.color='red';}else{alerta.innerText=`Quedan aprox ${Math.floor(saldoActual/(consumo||5))} dias`;}guardarRegistro({tipo:'dosificacion',operador:getOperador(),saldo_anterior:saldoAnt,consumo:consumo,saldo_actual:saldoActual,fecha:new Date().toISOString()});addActividad(`Dosificacion quedan ${saldoActual.toFixed(1)}L`);}
function guardarLavado(){guardarRegistro({tipo:'lavado',operador:getOperador(),unidad:document.getElementById('unidadLavado').value,fecha:document.getElementById('horaLavado').value||new Date().toISOString(),obs:document.getElementById('obsLavado').value});addActividad('Lavado '+document.getElementById('unidadLavado').value);alert('Lavado registrado');}
function guardarPh(tipo){const val=document.getElementById(tipo=='entrada'?'phEntrada':'phSalida').value;guardarRegistro({tipo:'ph',subtipo:tipo,valor:val,operador:getOperador(),fecha:new Date().toISOString()});addActividad('pH '+tipo+' '+val);}
function renderPlanilla(){const regs=getRegistros();const div=document.getElementById('planillaView');if(!div)return;if(regs.length==0){div.innerHTML='<p>Sin datos</p>';return;}let html='<table style="width:100%;font-size:11px;border-collapse:collapse"><tr><th>Fecha</th><th>Tipo</th><th>Op</th><th>Total</th></tr>';regs.slice(-30).forEach(r=>{html+=`<tr style="border-bottom:1px solid #ddd"><td>${new Date(r.fecha).toLocaleDateString()}</td><td>${r.tipo}</td><td>${r.operador||''}</td><td>${r.total||r.saldo_actual||r.valor||''}</td></tr>`});html+='</table><br><button onclick="exportarCSV()" class="btn secondary">Exportar CSV mensual</button>';div.innerHTML=html;}
function generarPlanilla(){renderPlanilla();alert('Planilla mensual generada - todos los menus alimentan esta tabla');}
function exportarCSV(){const regs=getRegistros();let csv='Fecha,Tipo,Operador,Total,Saldo\n';regs.forEach(r=>{csv+=`${r.fecha},${r.tipo},${r.operador||''},${r.total||r.valor||''},${r.saldo_actual||''}\n`});const blob=new Blob([csv],{type:'text/csv'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`planilla_${new Date().toISOString().slice(0,7)}.csv`;a.click();}
window.onload=()=>{updateOperadorUI();['horaIngreso','horaAforo1','horaAforo2','horaAforo3','horaDosis','horaLavado'].forEach(id=>setHoraAuto(id));document.getElementById('saldoAnteriorLabel').innerText=getSaldoAnterior().toFixed(1);calcularCaudal();try{new Chart(document.getElementById('chartPh'),{type:'line',data:{labels:['Lun','Mar','Mie','Jue','Vie','Sab','Hoy'],datasets:[{label:'pH Ent',data:[7.2,7.1,7.3,7.2,7.4,7.2,7.3],borderColor:'#42a5f5'},{label:'pH Sal',data:[7.0,6.9,7.1,7.0,7.2,7.0,7.1],borderColor:'#66bb6a'}]}});new Chart(document.getElementById('chartQuimico'),{type:'line',data:{labels:['Lun','Mar','Mie','Jue','Vie','Sab','Hoy'],datasets:[{label:'Consumo L',data:[5,4,6,5,7,4,5],borderColor:'#7c4dff'}]}});}catch(e){}}
</script>
</body>
</html>
